# Copy into the runtime environment only. Never commit real values.
HERMES_ENDPOINT=
HERMES_TOKEN=
GITHUB_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SLACK_BOT_TOKEN=
NOTION_TOKEN=
JARVIS_PORT=8787
# This pilot permits loopback only. It is not a public deployment endpoint.
JARVIS_HOST=127.0.0.1
# Both switches must opt in before any provider advisory call is possible.
JARVIS_DRY_RUN=true
JARVIS_ALLOW_EXTERNAL=false
# Private random 32–256-character URL-safe token; required for POST /tasks.
# It is scoped to the single pilot repository and cannot approve releases.
JARVIS_RUNTIME_TOKEN=
# Pilot repository only; all other repositories are refused until explicitly expanded.
JARVIS_PILOT_REPOSITORY=
# Required per configured AI provider for advisory calls; no model defaults.
# Select supported model IDs explicitly. Local tests do not verify availability.
OPENAI_MODEL=
GEMINI_MODEL=
ANTHROPIC_MODEL=
# Prompt #11 loads ../config/prompt-11-profile.json from the repository layout.
# There is no profile path, URL, identity or revision override in the environment.
