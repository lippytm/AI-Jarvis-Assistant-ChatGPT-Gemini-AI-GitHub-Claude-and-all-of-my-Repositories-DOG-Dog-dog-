{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lippytm/AI-Jarvis-Assistant-ChatGPT-Gemini-AI-GitHub-Claude-and-all-of-my-Repositories-DOG-Dog-dog-/blob/main/schemas/work-envelope.schema.json",
  "title": "Jarvis coding work envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "repository", "goal", "scope", "risk_class", "allowed_tools", "prohibited_actions", "acceptance_tests", "approval_state", "input_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bundle_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "goal": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "risk_class": {"enum": ["read-only", "reversible-draft", "approval-required"]},
    "allowed_tools": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "prohibited_actions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "acceptance_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "approval_state": {"enum": ["pending", "approved", "rejected"]},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
